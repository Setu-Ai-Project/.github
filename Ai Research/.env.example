# ==============================================================================
# SetuAI - AI Research Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your actual API keys below.
# 3. NEVER commit your real .env file to Git!
# ==============================================================================

# Image Generation API (e.g., Stability AI)
# Obtain your key at: https://platform.stability.ai/
STABILITY_API_KEY=your_stability_api_key_here

# Anthropic Claude API (for feedback and hints)
# Obtain your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CLIP Model Name (loaded locally from Hugging Face, no API key required)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
