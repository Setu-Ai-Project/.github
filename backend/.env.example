DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/neuroteach_db

# Clerk JWT authentication (public JWKS verification)
# Must begin with https:// and have NO trailing slash.
# Collect this from Clerk Dashboard -> API Keys -> Frontend API URL (Issuer URL)
CLERK_ISSUER=https://example-00.clerk.accounts.dev

# Comma-separated list of frontend origins the browser may call this API from (CORS).
# Exact match required: scheme + host + port, no trailing slash. Wildcard '*' is disallowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Cloudinary image storage (certificates)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
