DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/neuroteach_db

# Clerk authentication (backend verification) — get this from the Clerk
# dashboard, same project as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=sk_test_...
# Optional: PEM public key for local (networkless) token verification.
# If left blank, verification falls back to Clerk's networked JWKS endpoint.
CLERK_JWT_KEY=
# Comma-separated list of allowed frontend origins (CSRF protection).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
