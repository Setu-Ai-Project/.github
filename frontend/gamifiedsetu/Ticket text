**2. Build the fake queue:** `api/mockDoubtApi.ts`
```ts
import type { Doubt } from "@/types/doubt";

// Flip to true to test the friendly error messages in the browser.
// NEVER commit this as true.
export const MOCK_FORCE_ERROR = false;

// How long every fake call takes, in milliseconds.
export const MOCK_DELAY_MS = 400;

// Where the fake queue is saved in the browser.
export const MOCK_STORAGE_KEY = "setuai_mock_doubts";

const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

// localStorage only exists in the browser, not on the server, so we check first.
function load(): Doubt[] {
  if (typeof window === "undefined") return [];
  try {
    return JSON.parse(window.localStorage.getItem(MOCK_STORAGE_KEY) ?? "[]");
  } catch {
    return []; // corrupted data → start fresh instead of crashing
  }
}

function save(list: Doubt[]) {
  window.localStorage.setItem(MOCK_STORAGE_KEY, JSON.stringify(list));
}

// Every fake call goes through this: wait, then maybe pretend the server is down.
async function fakeNetwork() {
  await wait(MOCK_DELAY_MS);
  if (MOCK_FORCE_ERROR) throw new Error("Mock server is down");
}

export async function mockListDoubts(): Promise<Doubt[]> {
  await fakeNetwork();
  return load();
}

export async function mockCreateDoubt(question: string, learnerName: string): Promise<Doubt> {
  await fakeNetwork();
  const doubt: Doubt = {
    id: crypto.randomUUID(), // unique id, even for two doubts sent in the same millisecond
    learnerName,
    question,
    status: "open",
    createdAt: new Date().toISOString(),
  };
  save([...load(), doubt]);
  return doubt;
}

export async function mockReplyToDoubt(
  id: string,
  text: string,
  mentorName: string
): Promise<Doubt> {
  await fakeNetwork();
  const list = load();
  const original = list.find((d) => d.id === id);
  if (!original) throw new Error(`No doubt with id ${id}`);

  // Make a NEW object instead of changing the old one ("immutability").
  const updated: Doubt = {
    ...original,
    status: "answered",
    reply: { mentorName, text, repliedAt: new Date().toISOString() },
  };
  save(list.map((d) => (d.id === id ? updated : d)));
  return updated;
}

// Empties the fake queue. Used by tests and the "Clear all" buttons on dev pages.
export function resetMockDoubts() {
  if (typeof window !== "undefined") {
    window.localStorage.removeItem(MOCK_STORAGE_KEY);
  }
}
```

**3. Build the single entry point:** `api/doubtApi.ts`. These three functions are the **only** way the app talks to the doubt queue. No component imports `mockDoubtApi` directly; the dev pages' "Clear all" button using `resetMockDoubts` is the one exception.
```ts
import type { Doubt } from "@/types/doubt";
import { mockCreateDoubt, mockListDoubts, mockReplyToDoubt } from "./mockDoubtApi";

// The backend isn't ready yet, so we use the mock. When it's ready, this becomes
// false and NEXT_PUBLIC_API_URL gets set. No component has to change.
export const USE_MOCK = true;

const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

export async function listDoubts(): Promise<Doubt[]> {
  if (USE_MOCK) return mockListDoubts();
  const res = await fetch(`${BASE_URL}/api/doubts`);
  if (!res.ok) throw new Error("Could not load doubts");
  return res.json();
}

export async function createDoubt(question: string, learnerName: string): Promise<Doubt> {
  if (USE_MOCK) return mockCreateDoubt(question, learnerName);
  const res = await fetch(`${BASE_URL}/api/doubts`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ question, learnerName }),
  });
  if (!res.ok) throw new Error("Could not send doubt");
  return res.json();
}

export async function replyToDoubt(id: string, text: string, mentorName: string): Promise<Doubt> {
  if (USE_MOCK) return mockReplyToDoubt(id, text, mentorName);
  const res = await fetch(`${BASE_URL}/api/doubts/${id}/reply`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ text, mentorName }),
  });
  if (!res.ok) throw new Error("Could not send reply");
  return res.json();
}
```
