      reply: { mentorName: "Test Mentor", text: "Use break.", repliedAt: "2026-10-02T10:00:00.000Z" },
    };
    mockedList.mockResolvedValueOnce([OLDER_OPEN]).mockResolvedValue([answered]);
    mockedReply.mockResolvedValue(answered);
