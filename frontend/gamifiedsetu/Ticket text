**2. Build the list:** `app/components/mentor-mode/MyDoubts.tsx`. It loads doubts when it first appears, and again whenever `reloadKey` changes. The form bumps `reloadKey` after sending. **Keep this exact loading pattern:** the shorter `useEffect(() => { refresh(); }, [])` fails this project's lint rules.
```tsx
"use client";

import { useEffect, useState } from "react";
import { listDoubts } from "@/api/doubtApi";
import type { Doubt } from "@/types/doubt";
import AskDoubtForm from "./AskDoubtForm";
import DoubtCard from "./DoubtCard";

export default function MyDoubts() {
  const [doubts, setDoubts] = useState<Doubt[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  // Bump this number to reload the list (e.g. after sending a doubt).
  const [reloadKey, setReloadKey] = useState(0);

  useEffect(() => {
    // If the component disappears before the data arrives, ignore the late answer.
    let ignore = false;

    listDoubts()
      .then((list) => {
        if (ignore) return;
        setDoubts(list);
        setError("");
      })
      .catch(() => {
        if (!ignore) setError("We could not load your doubts. Please refresh the page.");
      })
      .finally(() => {
        if (!ignore) setLoading(false);
      });

    return () => {
      ignore = true;
    };
  }, [reloadKey]); // runs on first render, and again whenever reloadKey changes

  // Newest first, so a doubt you just sent appears at the top.
  const newestFirst = [...doubts].sort((a, b) => b.createdAt.localeCompare(a.createdAt));

  return (
    <div className="space-y-6">
      <AskDoubtForm onSent={() => setReloadKey((key) => key + 1)} />

      <h2 className="font-display text-xl font-bold text-ink">My doubts</h2>

      {loading && <p className="text-taskgray">Loading your doubts...</p>}

      {error && (
        <p className="rounded-xl border-2 border-coral bg-white p-3 font-bold text-ink">{error}</p>
      )}

      {!loading && !error && newestFirst.length === 0 && (
        <p className="text-taskgray">No doubts yet. Ask your first one above!</p>
      )}

      <div className="space-y-4">
        {newestFirst.map((doubt) => (
          <DoubtCard key={doubt.id} doubt={doubt} />
        ))}
      </div>
    </div>
  );
}
```

