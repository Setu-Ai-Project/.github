            {adding ? "Adding..." : "Add sample doubt"}
          </button>
          <button type="button" onClick={clearAll} className="rounded-full border-2 border-ink bg-white px-4 py-1 font-bold text-ink">
            Clear all doubts
          </button>
        </div>
        <MentorDashboard key={version} />
