    expect(result.current.totalXp).toBe(0);
  });

  it("shows pending while the check is running, then done", async () => {
    let finish!: (value: SubmissionResult) => void;
    mockedSubmit.mockReturnValue(new Promise((resolve) => (finish = resolve)));
    const { result } = renderHook(() => useSubmission("c1"));

    act(() => {
      void result.current.submit("hello");
    });
    expect(result.current.uiState).toBe("submitting");
    expect(result.current.result?.status).toBe("pending");

    await act(async () => finish(NEEDS_REVISION));
    expect(result.current.uiState).toBe("done");
  });

  it("sends the challenge id and answer to the API", async () => {
    mockedSubmit.mockResolvedValue(PASSED);
    const { result } = renderHook(() => useSubmission("c1"));
    await act(() => result.current.submit("correct"));
    expect(mockedSubmit).toHaveBeenCalledWith("c1", "correct");
  });

  it("adds XP when the answer passes", async () => {
    mockedSubmit.mockResolvedValue(PASSED);
    const { result } = renderHook(() => useSubmission("c1"));
    await act(() => result.current.submit("correct"));
    expect(result.current.result?.status).toBe("passed");
    expect(result.current.totalXp).toBe(50);
  });

  it("keeps XP at 0 and returns the tips when revision is needed", async () => {
    mockedSubmit.mockResolvedValue(NEEDS_REVISION);
    const { result } = renderHook(() => useSubmission("c1"));
    await act(() => result.current.submit("hello"));
    expect(result.current.result?.feedback).toHaveLength(2);
    expect(result.current.totalXp).toBe(0);
  });

  it("goes to the error state when the API fails", async () => {
    mockedSubmit.mockRejectedValue(new Error("boom"));
    const { result } = renderHook(() => useSubmission("c1"));
    await act(() => result.current.submit("hello"));
    expect(result.current.uiState).toBe("error");
    expect(result.current.result).toBeNull();
  });

  it("retry clears the result and goes back to idle", async () => {
    mockedSubmit.mockResolvedValue(NEEDS_REVISION);
    const { result } = renderHook(() => useSubmission("c1"));
    await act(() => result.current.submit("hello"));
    act(() => result.current.retry());
    expect(result.current.uiState).toBe("idle");
    expect(result.current.result).toBeNull();
  });

  it("only sends one request when submit is called twice quickly", async () => {
    mockedSubmit.mockResolvedValue(PASSED);
    const { result } = renderHook(() => useSubmission("c1"));
    await act(async () => {
      void result.current.submit("correct");
      void result.current.submit("correct");
    });
    expect(mockedSubmit).toHaveBeenCalledTimes(1);
  });
});
