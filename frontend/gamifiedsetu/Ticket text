import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import {
  MOCK_DELAY_MS,
  MOCK_STORAGE_KEY,
  mockCreateDoubt,
  mockListDoubts,
  mockReplyToDoubt,
  resetMockDoubts,
} from "./mockDoubtApi";

// Fake timers let us skip the 400ms wait instead of really waiting.
async function run<T>(promise: Promise<T>): Promise<T> {
  await vi.advanceTimersByTimeAsync(MOCK_DELAY_MS);
  return promise;
}

describe("mock doubt queue", () => {
  beforeEach(() => {
    vi.useFakeTimers();
    resetMockDoubts(); // every test starts with an empty queue
  });
  afterEach(() => vi.useRealTimers());

  it("starts empty", async () => {
    expect(await run(mockListDoubts())).toEqual([]);
  });

  it("creates an open doubt with no reply", async () => {
    const doubt = await run(mockCreateDoubt("How do I stop an infinite loop?", "Test Learner"));
    expect(doubt.status).toBe("open");
    expect(doubt.question).toBe("How do I stop an infinite loop?");
    expect(doubt.learnerName).toBe("Test Learner");
    expect(doubt.reply).toBeUndefined();
    expect(await run(mockListDoubts())).toEqual([doubt]);
  });

  it("gives every doubt a different id", async () => {
    const a = await run(mockCreateDoubt("First question", "Test Learner"));
    const b = await run(mockCreateDoubt("Second question", "Test Learner"));
    expect(a.id).not.toBe(b.id);
  });

  it("a reply marks the doubt answered and attaches the reply", async () => {
    const doubt = await run(mockCreateDoubt("What is a variable?", "Test Learner"));
    const updated = await run(mockReplyToDoubt(doubt.id, "A named box for a value.", "Test Mentor"));

    expect(updated.status).toBe("answered");
    expect(updated.reply?.text).toBe("A named box for a value.");
    expect(updated.reply?.mentorName).toBe("Test Mentor");

    const [saved] = await run(mockListDoubts());
    expect(saved.status).toBe("answered");
  });

  it("saves to localStorage so data survives a reload", async () => {
    await run(mockCreateDoubt("Saved question", "Test Learner"));
    expect(window.localStorage.getItem(MOCK_STORAGE_KEY)).toContain("Saved question");
  });

  it("rejects a reply to a doubt that does not exist", async () => {
    const promise = mockReplyToDoubt("does-not-exist", "Hello", "Test Mentor");
    const assertion = expect(promise).rejects.toThrow();
    await vi.advanceTimersByTimeAsync(MOCK_DELAY_MS);
    await assertion;
  });
});
