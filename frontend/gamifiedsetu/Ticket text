**3. Build the hook:** `hooks/useSubmission.ts`. The first line must be `"use client"`.
```ts
"use client";

import { useRef, useState } from "react";
import { submitAnswer } from "@/api/submissionApi";
import type { SubmissionResult, UiState } from "@/types/submission";

export function useSubmission(challengeId: string) {
  const [result, setResult] = useState<SubmissionResult | null>(null);
  const [uiState, setUiState] = useState<UiState>("idle");
  const [totalXp, setTotalXp] = useState(0);

  // State updates don't land instantly, so two very fast clicks could both get in
  // before the button re-renders as disabled. A ref updates immediately, so it
  // stops the second click.
  const inFlight = useRef(false);

  async function submit(answer: string) {
    if (inFlight.current) return; // a check is already running, ignore the extra call
    inFlight.current = true;

    setUiState("submitting");
    // Show "pending" straight away, before the server replies.
    setResult({ status: "pending", feedback: [], xpEarned: 0 });

    try {
      const response = await submitAnswer(challengeId, answer);
      setResult(response);
      setUiState("done");
      if (response.status === "passed") {
        setTotalXp((xp) => xp + response.xpEarned);
      }
    } catch {
      // The panel shows a friendly message for this state.
      setResult(null);
      setUiState("error");
    } finally {
      inFlight.current = false; // allow the next submit
    }
  }

  // Clears the RESULT only. The typed answer lives in the panel, so it survives.
  function retry() {
    setResult(null);
    setUiState("idle");
  }

  return { result, uiState, totalXp, submit, retry };
}
```
Note: `totalXp` lives in memory only and resets on page reload. That's expected for now. Its job is to show the XP change straight after a pass.

