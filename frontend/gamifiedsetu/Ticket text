```tsx
"use client";

import { useRef, useState } from "react";
import { createDoubt } from "@/api/doubtApi";

// Until login is wired in, every doubt is sent as this test learner.
export const TEST_LEARNER_NAME = "Test Learner";

// Shorter than this and the question is probably not useful to a mentor.
const MIN_QUESTION_LENGTH = 5;

type AskDoubtFormProps = {
  onSent: () => void; // tells the parent "a doubt was sent, reload your list"
};

type Message = { text: string; isError: boolean };

export default function AskDoubtForm({ onSent }: AskDoubtFormProps) {
  const [question, setQuestion] = useState("");
  const [sending, setSending] = useState(false);
  const [message, setMessage] = useState<Message | null>(null);

  // Stops a very fast double-click from sending two doubts. A ref changes
  // instantly; state only changes on the next render.
  const inFlight = useRef(false);

  async function handleSend() {
    if (inFlight.current) return;

    const trimmed = question.trim();
    if (trimmed.length < MIN_QUESTION_LENGTH) {
      setMessage({ text: "Please describe your doubt in a few words.", isError: true });
      return;
    }

    inFlight.current = true;
    setSending(true);
    setMessage(null);
    try {
      await createDoubt(trimmed, TEST_LEARNER_NAME);
      setQuestion(""); // clear the box only when it worked
      setMessage({ text: "Doubt sent! A mentor will reply soon.", isError: false });
      onSent();
    } catch {
      // Keep their text so they don't lose it.
      setMessage({ text: "We could not send your doubt. Please try again.", isError: true });
    } finally {
      // "finally" always runs, success or failure, so "sending" can never get stuck on.
      inFlight.current = false;
      setSending(false);
    }
  }

  return (
    <section className="space-y-3 rounded-2xl border-4 border-ink bg-white p-4 shadow-[8px_8px_0_#172A32] sm:p-6">
      <label htmlFor="ask-doubt" className="font-display text-lg font-bold text-ink">
        Ask a doubt
      </label>
      <textarea
        id="ask-doubt"
        className="h-28 w-full resize-y rounded-xl border-2 border-ink bg-cream p-3 text-ink placeholder:text-taskgray focus:outline-none focus:ring-2 focus:ring-tealpop disabled:opacity-60"
        placeholder="What are you stuck on?"
        value={question}
        onChange={(e) => setQuestion(e.target.value)}
        disabled={sending}
      />
      <button
        type="button"
        onClick={handleSend}
        disabled={sending}
        className="rounded-2xl border-4 border-ink bg-tealpop px-6 py-2 font-display text-lg font-bold text-ink shadow-[4px_4px_0_#172A32] transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0"
      >
        {sending ? "Sending..." : "Send doubt"}
      </button>
      {message && (
        <p
          role="status"
          className={`text-sm font-bold text-ink ${
            message.isError ? "rounded-xl border-2 border-coral bg-cream p-2" : ""
          }`}
        >
          {message.text}
        </p>
      )}
    </section>
  );
}
