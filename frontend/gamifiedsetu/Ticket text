// Which view the app is showing. Controlled by the Learner/Mentor switch.
export type Mode = "learner" | "mentor";

// A doubt is either still waiting ("open") or has a mentor reply ("answered").
export type DoubtStatus = "open" | "answered";

// The mentor's answer to a doubt.
export interface MentorReply {
  mentorName: string;
  text: string;
  repliedAt: string; // ISO date text, e.g. "2026-10-02T10:30:00.000Z"
}

// One question from a learner: one row of the doubt queue.
export interface Doubt {
  id: string;
  learnerName: string;
  question: string;
  status: DoubtStatus;
  createdAt: string; // ISO date text
  reply?: MentorReply; // "?" = optional. It's missing until a mentor replies.
}
