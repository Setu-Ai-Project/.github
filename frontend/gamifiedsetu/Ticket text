**1. Build the shared mode:** `context/ModeContext.tsx`. A *context* is like a shared backpack: the `ModeProvider` fills it, and any component inside can read it with `useMode()` without the value being passed down through props.
```tsx
"use client";

import { createContext, useContext, useState, type ReactNode } from "react";
import type { Mode } from "@/types/doubt";

type ModeContextValue = {
  mode: Mode;
  setMode: (mode: Mode) => void;
};

// null = "no provider above me". useMode() turns that into a clear error.
const ModeContext = createContext<ModeContextValue | null>(null);

type ModeProviderProps = {
  children: ReactNode;
  initialMode?: Mode; // defaults to "learner"
};

// Wrap a page in this so everything inside can read and change the mode.
export function ModeProvider({ children, initialMode = "learner" }: ModeProviderProps) {
  const [mode, setMode] = useState<Mode>(initialMode);
  return <ModeContext.Provider value={{ mode, setMode }}>{children}</ModeContext.Provider>;
}

// The shortcut components use: const { mode, setMode } = useMode();
export function useMode() {
  const context = useContext(ModeContext);
  if (!context) {
    throw new Error("useMode must be used inside <ModeProvider>");
  }
  return context;
}
```

**2. Build the switch:** `app/components/mentor-mode/ModeSwitch.tsx`. `aria-pressed` tells screen readers which option is on.
```tsx
"use client";

import { useMode } from "@/context/ModeContext";
import type { Mode } from "@/types/doubt";

const OPTIONS: { value: Mode; label: string }[] = [
  { value: "learner", label: "Learner" },
  { value: "mentor", label: "Mentor" },
];

export default function ModeSwitch() {
  const { mode, setMode } = useMode();

  return (
    <div
      role="group"
      aria-label="Switch mode"
      className="inline-flex gap-1 rounded-full border-4 border-ink bg-white p-1 shadow-[4px_4px_0_#172A32]"
    >
      {OPTIONS.map((option) => {
        const active = mode === option.value;
        return (
          <button
            key={option.value}
            type="button"
            onClick={() => setMode(option.value)}
            aria-pressed={active}
            className={`rounded-full px-4 py-1 font-display text-sm font-bold text-ink transition-colors ${
              active ? "bg-tealpop" : "hover:bg-cream"
            }`}
          >
            {option.label}
          </button>
        );
      })}
    </div>
  );
}
