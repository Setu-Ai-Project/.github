```ts
import type { AnswerCheck, BuilderChallenge, LearnContent, Quiz } from "@/types/learning";
import { mockCheckAnswer, mockGetChallenge, mockGetLearnContent, mockGetQuiz } from "./mockLearning";

// Every Step 4 screen gets its data through this file, so swapping the mock for
// the real backend later is a change in ONE place.

// Mock or real? Read the env WHEN CALLED (not at the top of the file), so tests
// can change it. Same rule as api/submissionApi.ts.
function shouldUseMock(): boolean {
  return process.env.NEXT_PUBLIC_USE_MOCK === "true" || !process.env.NEXT_PUBLIC_API_URL;
}

// `async` means this function may need to wait. `await` pauses here until the
// server answers, without freezing the page.
async function requestJson<T>(path: string, errorMessage: string, init?: RequestInit): Promise<T> {
  const res = await fetch(`${process.env.NEXT_PUBLIC_API_URL}${path}`, init);
  if (!res.ok) throw new Error(errorMessage);
  return (await res.json()) as T;
}

// ASSUMPTION - confirm with Backend (SYNC 3): the shape we expect the backend to send.
type RawQuiz = {
  id: number;
  module_id: number;
  title: string;
  questions: { id: number; question: string; options: string[]; explanation?: string }[];
};

// Mapper: turns the backend's snake_case + number ids into our camelCase + string ids.
function toQuiz(raw: RawQuiz): Quiz {
  return {
    id: String(raw.id),
    moduleId: String(raw.module_id),
    title: raw.title,
    // Never copy a correct answer into the result.
    questions: raw.questions.map((q) => ({
      id: String(q.id),
      question: q.question,
      options: q.options,
      explanation: q.explanation,
    })),
  };
}

export async function getQuiz(moduleId: string): Promise<Quiz> {
  if (shouldUseMock()) return mockGetQuiz(moduleId);
  // ASSUMPTION - confirm with Backend (SYNC 3)
  const raw = await requestJson<RawQuiz>(`/modules/${moduleId}/quiz`, "Could not load quiz");
  return toQuiz(raw);
}

