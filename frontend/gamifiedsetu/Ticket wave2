**9. `hooks/useAsync.ts`** — runs a load function and tracks `data` / `loading` / `error`, with a `reload` for "Try again". It follows the reloadKey pattern, so it passes the `react-hooks/set-state-in-effect` lint rule.
```ts
"use client";

import { useCallback, useEffect, useState } from "react";

// Runs an async `load` function and tracks loading / error / data for a screen.
//
// `load` must be stable. Wrap it in useCallback with the ids it uses, e.g.
//   const load = useCallback(() => getQuiz(moduleId), [moduleId]);
// If you pass a new arrow function every render, the effect re-runs every
// render and loads forever.
export function useAsync<T>(load: () => Promise<T>) {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  // Increment this to load again (the "reloadKey pattern").
  const [reloadKey, setReloadKey] = useState(0);

  useEffect(() => {
    // Becomes true when the screen goes away or reloads, so a late answer is ignored.
    let ignore = false;

    // Only the promise callbacks set state, never the effect body itself (lint rule).
    load()
      .then((result) => {
        if (ignore) return;
        setData(result);
        setError(null);
      })
      .catch((err: unknown) => {
        if (ignore) return;
        setError(err instanceof Error ? err : new Error(String(err)));
      })
      .finally(() => {
        if (!ignore) setLoading(false);
      });

    return () => {
      ignore = true;
    };
  }, [load, reloadKey]);

  // Called from a "Try again" click, so setting state here is fine.
  const reload = useCallback(() => {
    setLoading(true);
    setError(null);
    setReloadKey((key) => key + 1);
  }, []);

  return { data, loading, error, reload };
}
```

