```ts
import type { ProgressSnapshot, Skill, SkillStatus } from "@/types/progress";
import { levelProgress } from "@/utils/levels";
import { mockFetchProgress } from "./mockProgress";

// Mock or real? Read the env WHEN CALLED (not at the top of the file), so tests
// can change it. Same rule as api/submissionApi.ts.
function shouldUseMock(): boolean {
  return process.env.NEXT_PUBLIC_USE_MOCK === "true" || !process.env.NEXT_PUBLIC_API_URL;
}

// ASSUMPTION - confirm with Backend (SYNC 4). Today /progress/me sends total_xp,
// level, xp_to_next_level, badges and certificates, but NO skills yet.
type RawSkill = {
  id: number;
  name: string;
  description: string;
  module_id: number;
  status: SkillStatus;
  prerequisites: number[];
  xp_reward: number;
  progress?: number;
};
type RawProgress = { total_xp: number; skills?: RawSkill[] };

// Mapper: backend snake_case + number ids → our camelCase + string ids.
function toSkill(raw: RawSkill): Skill {
  return {
    id: String(raw.id),
    name: raw.name,
    description: raw.description,
    moduleId: String(raw.module_id),
    status: raw.status,
    prerequisites: raw.prerequisites.map(String),
    xpReward: raw.xp_reward,
    progress: raw.progress,
  };
}

function toSnapshot(raw: RawProgress): ProgressSnapshot {
  // The backend sends "XP still needed"; our bar needs "XP into the level" and
  // "level size", so we work them out from total XP with the backend's own thresholds.
  const { level, xpIntoLevel, xpForNextLevel } = levelProgress(raw.total_xp);
  return {
    totalXp: raw.total_xp,
    level,
    xpIntoLevel,
    xpForNextLevel,
    // No skills from the backend yet → an empty map instead of a crash.
    skills: raw.skills ? raw.skills.map(toSkill) : [],
  };
}

// `async` means this function may need to wait; `await` pauses until the answer arrives.
export async function fetchProgress(token?: string | null): Promise<ProgressSnapshot> {
  if (shouldUseMock()) return mockFetchProgress();

  const res = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/progress/me`, {
    headers: token ? { Authorization: `Bearer ${token}` } : {},
  });

  // A brand-new learner has no progress row yet: show zero progress, not an error.
  if (res.status === 404) return toSnapshot({ total_xp: 0 });
  if (!res.ok) throw new Error("Could not load progress");

  return toSnapshot((await res.json()) as RawProgress);
}
```

**5. `hooks/useProgressPolling.ts`** — keeps progress fresh: fetches now, then every few seconds. Use this code exactly. It passes our lint rule because state is only set **after** an `await`, never directly in the effect body:
```ts
"use client";

import { useEffect, useState } from "react";
import { useAuth } from "@clerk/nextjs";
import { fetchProgress } from "@/api/progressApi";
import type { ProgressSnapshot } from "@/types/progress";

// How often to ask for fresh progress. Set NEXT_PUBLIC_POLL_INTERVAL_MS to change it.
export const DEFAULT_POLL_MS = Number(process.env.NEXT_PUBLIC_POLL_INTERVAL_MS) || 5000;

// Fetches progress now, then every `intervalMs`, but only while the tab is visible.
// Changing `refreshKey` fetches again straight away ("Try again" and Task 20's
// WebSocket use this).
export function useProgressPolling(intervalMs: number = DEFAULT_POLL_MS, refreshKey = 0) {
  const { getToken } = useAuth();
  const [data, setData] = useState<ProgressSnapshot | null>(null);
  const [error, setError] = useState<Error | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // Becomes true when the page goes away, so late answers are ignored.
    let cancelled = false;
    let timer: ReturnType<typeof setInterval> | undefined;

    async function load() {
      try {
        const token = await getToken(); // the logged-in learner's Clerk token (null in mock mode is fine)
        const snapshot = await fetchProgress(token);
        if (cancelled) return;
        setData(snapshot);
        setError(null);
      } catch (err) {
        if (cancelled) return;
        // Keep the old data on screen; just remember the error.
        setError(err instanceof Error ? err : new Error(String(err)));
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    function start() {
      void load(); // fetch now...
      timer = setInterval(() => void load(), intervalMs); // ...then again every intervalMs
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = undefined;
    }

    // Pause while the tab is hidden; fetch straight away when it comes back.
    function onVisibilityChange() {
      if (document.visibilityState === "hidden") stop();
      else if (!timer) start();
    }

    if (document.visibilityState !== "hidden") start();
    document.addEventListener("visibilitychange", onVisibilityChange);

    // CLEANUP: stop the timer and the listener when the page goes away.
    // Forgetting this keeps polling forever in the background.
    return () => {
      cancelled = true;
      stop();
      document.removeEventListener("visibilitychange", onVisibilityChange);
    };
  }, [intervalMs, refreshKey, getToken]);

  return { data, error, loading };
}
```

