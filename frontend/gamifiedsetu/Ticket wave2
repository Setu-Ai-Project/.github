```ts
"use client";

import { useEffect, useState } from "react";

export type SocketStatus = "off" | "connecting" | "open" | "closed";

const PING_MS = 25000; // keep-alive: the backend answers "ping" with "pong"
const MAX_RETRY_MS = 30000;

// Opens a WebSocket and counts the messages the server pushes.
// `buildUrl` returns the full URL (with a fresh login token) or null.
// Pass null instead of a function to switch the socket off (e.g. in mock mode).
// `buildUrl` must be stable: wrap it in useCallback.
export function useProgressSocket(buildUrl: (() => Promise<string | null>) | null) {
  const [status, setStatus] = useState<SocketStatus>("connecting");
  const [messageCount, setMessageCount] = useState(0);

  useEffect(() => {
    if (!buildUrl) return; // switched off
    const getUrl = buildUrl;

    let socket: WebSocket | null = null;
    let retryTimer: ReturnType<typeof setTimeout> | undefined;
    let pingTimer: ReturnType<typeof setInterval> | undefined;
    let retryMs = 1000;
    let stopped = false; // true after cleanup: never reconnect

    async function connect() {
      // Ask for the URL each time, so every reconnect uses a fresh token.
      const url = await getUrl();
      if (stopped) return;
      if (!url) {
        setStatus("closed");
        return;
      }

      socket = new WebSocket(url);

      // onopen: connected. Reset the retry delay and start the keep-alive ping.
      socket.onopen = () => {
        retryMs = 1000;
        setStatus("open");
        pingTimer = setInterval(() => socket?.send("ping"), PING_MS);
      };

      // onmessage: the server pushed something. "pong" is only the keep-alive reply;
      // anything else is the doorbell: count it so progress gets fetched now.
      socket.onmessage = (event: MessageEvent) => {
        if (event.data === "pong") return;
        setMessageCount((count) => count + 1);
      };

      // onclose: dropped or refused. Try again after a growing delay: 1s, 2s, 4s ... 30s.
      // (Browsers fire onclose after onerror, so onclose alone is enough.)
      socket.onclose = () => {
        if (pingTimer) clearInterval(pingTimer);
        if (stopped) return;
        setStatus("closed");
        retryTimer = setTimeout(() => {
          setStatus("connecting");
          void connect();
        }, retryMs);
        retryMs = Math.min(retryMs * 2, MAX_RETRY_MS);
      };
    }

    void connect();

    // CLEANUP: never reconnect, stop both timers, close the socket.
    return () => {
      stopped = true;
      if (retryTimer) clearTimeout(retryTimer);
      if (pingTimer) clearInterval(pingTimer);
      socket?.close();
    };
  }, [buildUrl]);

  // Without a URL builder the socket is simply off.
  return { status: buildUrl ? status : "off", messageCount };
}
```

