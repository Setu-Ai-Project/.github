**2. `hooks/useUnlockDetector.ts`** — remembers the previous snapshot and queues celebrations. Use this code exactly. It compares **during render**, which is React's recommended way to react to a changed value without an effect, so it passes our lint rule:
```ts
"use client";

import { useState } from "react";
import type { ProgressSnapshot } from "@/types/progress";
import { findUnlocks, type Celebration } from "@/utils/findUnlocks";

// Watches progress snapshots and returns the celebration to show right now.
// - The FIRST snapshot never celebrates (otherwise every page load would replay old unlocks).
// - The same celebration id never fires twice.
// - Several at once are queued and shown one after another.
export function useUnlockDetector(snapshot: ProgressSnapshot | null) {
  const [previous, setPrevious] = useState<ProgressSnapshot | null>(null);
  const [queue, setQueue] = useState<Celebration[]>([]);
  const [seenIds, setSeenIds] = useState<string[]>([]);

  // A new snapshot arrived: compare it with the one before.
  if (snapshot !== previous) {
    setPrevious(snapshot);
    if (previous && snapshot) {
      const fresh = findUnlocks(previous, snapshot).filter((c) => !seenIds.includes(c.id));
      if (fresh.length > 0) {
        setQueue((q) => [...q, ...fresh]);
        setSeenIds((ids) => [...ids, ...fresh.map((c) => c.id)]);
      }
    }
  }

  // Removes a celebration once the learner dismisses it, so the next one shows.
  function dismiss(id: string) {
    setQueue((q) => q.filter((c) => c.id !== id));
  }

  return { current: queue[0] ?? null, dismiss };
}
```

