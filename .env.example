# ==============================================================================
# SetuAI Project - Master Environment Configuration Template
# ==============================================================================
# This template lists all environment variables used across the project services.
# 
# Instructions:
# 1. Do NOT put real secrets in this example file.
# 2. To configure a service, copy its variables into a local `.env` or `.env.local`
#    in its respective directory (or in root).
# 3. All `.env` and `.env.local` files are ignored by git to prevent leaks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (frontend/gamifiedsetu/.env.local)
# ------------------------------------------------------------------------------
# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Backend API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Feature Flags & Polling
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_POLL_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 2. Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/neuroteach_db

# Clerk JWT authentication (public JWKS verification)
# Must begin with https:// and have NO trailing slash
CLERK_ISSUER=https://example-00.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# CORS Allowed Origins (comma-separated, no wildcards '*')
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Cloudinary Storage (for certificates/media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 3. AI Research Configuration (Ai Research/.env)
# ------------------------------------------------------------------------------
# Stability AI Key (for generative image creation)
STABILITY_API_KEY=your_stability_api_key_here

# Anthropic Claude API Key (for feedback and hints)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local CLIP Model Name (loaded from Hugging Face)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
